rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow create: if isOwner(uid)
        && request.resource.data.role == 'student'
        && request.resource.data.email == request.auth.token.email;
      allow read: if isOwner(uid);
      allow update, delete: if false;

      match /results/{resultId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.id == resultId
          && request.resource.data.total is number
          && request.resource.data.score is number;
        allow update, delete: if false;
      }

      match /examSessions/{examId} {
        allow read, create, update, delete: if false;
      }
    }

    // Practice questions are readable by signed-in students.
    // The question documents contain the answer index, so this direct-client
    // architecture is intended for practice use rather than high-stakes exams.
    match /questions/{id} {
      allow read: if signedIn() && resource.data.active == true;
      allow write: if false;
    }

    match /answerKeys/{id} {
      allow read, write: if false;
    }

    match /rateLimits/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
